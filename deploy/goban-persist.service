[Unit]
Description=Persist GoBan default firewall sets across reboot
Documentation=https://github.com/izm1chael/goban
After=ipset.service iptables.service nftables.service
Before=goban-enforcer.service goban.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/goban
ExecStart=/bin/sh -ec 'test ! -s /var/lib/goban/ipset.dump || /usr/sbin/ipset restore -exist -f /var/lib/goban/ipset.dump; test ! -s /var/lib/goban/nftables.dump || /usr/sbin/nft -f /var/lib/goban/nftables.dump'
ExecStop=/bin/sh -ec 'tmp=/var/lib/goban/ipset.dump.tmp; : > "$tmp"; for set in goban-ban-v4 goban-ban-v6; do /usr/sbin/ipset list -n 2>/dev/null | /bin/grep -Fxq "$set" && /usr/sbin/ipset save "$set" >> "$tmp" || true; done; mv "$tmp" /var/lib/goban/ipset.dump; /usr/sbin/nft list table inet goban > /var/lib/goban/nftables.dump.tmp 2>/dev/null && mv /var/lib/goban/nftables.dump.tmp /var/lib/goban/nftables.dump || rm -f /var/lib/goban/nftables.dump.tmp'

[Install]
WantedBy=multi-user.target
