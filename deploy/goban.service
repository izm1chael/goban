[Unit]
Description=GoBan log watcher and decision engine
Documentation=https://github.com/izm1chael/goban
After=network-online.target goban-enforcer.service
Wants=network-online.target
Requires=goban-enforcer.service

[Service]
Type=exec
ExecStart=/usr/bin/goban-daemon --config /etc/goban/goban.yaml --enforcer-mode=split
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Packaged deployments privilege-separate by default. This process parses
# attacker-controlled logs and evaluates rules but has no firewall capability.
User=goban
Group=goban
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true

# systemd-managed directories are owned by User=goban.
RuntimeDirectory=goban
RuntimeDirectoryMode=0755
StateDirectory=goban
StateDirectoryMode=0700
LogsDirectory=goban
LogsDirectoryMode=0750

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/goban /var/lib/goban /var/log/goban
ReadOnlyPaths=/etc/goban
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
