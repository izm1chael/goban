#include <tunables/global>

/usr/bin/goban-daemon flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/nameservice>

  /usr/bin/goban-daemon mr,
  /etc/goban/ r,
  /etc/goban/** r,

  # File/journal sources. Deployments reading logs outside these conventional
  # roots should extend the local override instead of broadening this profile.
  /var/log/ r,
  /var/log/** r,
  /run/log/journal/ r,
  /run/log/journal/** r,
  /var/log/journal/ r,
  /var/log/journal/** r,
  /run/systemd/journal/ r,
  /run/systemd/journal/** rw,

  # Detector-owned state, audit and control endpoints.
  /var/lib/goban/ rw,
  /var/lib/goban/** rwk,
  /var/log/goban/ rw,
  /var/log/goban/** rwk,
  /run/goban/ rw,
  /run/goban/** rwk,

  # Typed connection to the separate firewall helper.
  /run/goban-enforcer/enforcer.sock rw,

  # Docker source support is optional. Access remains constrained by Unix
  # ownership; packaged installs deliberately do not add goban to docker group.
  /run/docker.sock rw,
  /var/run/docker.sock rw,

  /proc/@{pid}/status r,
  /proc/sys/kernel/random/boot_id r,

  network unix,

  # Explicitly deny the most sensitive mutable trees even if a future
  # abstraction becomes broader than expected.
  deny /home/** rwklx,
  deny /root/** rwklx,
  deny /etc/** wklx,
  deny /usr/** wkl,
}
